{
  "name": "@nexus/ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "Exchange connectors + Stage-A structural data-quality validation (M5)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "live:ingest": "tsx src/cli/live-ingest.ts",
    "ci:seal-phase9": "tsx src/ci/seal-phase9-runtime.ts"
  },
  "dependencies": {
    "@nexus/core": "workspace:*",
    "@nexus/db": "workspace:*",
    "@nexus/events": "workspace:*",
    "ioredis": "^5.6.1",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
