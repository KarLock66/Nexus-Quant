# PostgreSQL (TimescaleDB) — matches docker/docker-compose.yml defaults
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus_quant

# Redis — queues (BullMQ) + pub/sub
REDIS_URL=redis://localhost:6379

# Internal quant service (FastAPI)
QUANT_SERVICE_URL=http://localhost:8000
QUANT_SERVICE_SHARED_SECRET=change-me-dev-secret

# Claude API (M2 AI agents — Phase 5)
ANTHROPIC_API_KEY=

# Web
NEXTAUTH_SECRET=change-me-dev-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator token for the MUTATING control-plane endpoints (kill switch, resume,
# operator actions). FAIL-CLOSED: while unset, those commands are refused with
# 503 — set it, restart the web app, and paste the same value into the
# "operator token" field on the Control Center / Operations pages.
OPS_CONTROL_TOKEN=

# ── Zero-synthetic discipline ──────────────────────────────────────────────
# There is NO demo mode. The platform runs exclusively on real ingested market
# data; the pipeline FAILS FAST when upstream data is missing instead of
# fabricating it. Setting the legacy DEMO_MODE variable anywhere fails
# `pnpm start:prod` validation outright.

# ── Production runtime (live trading pipeline) ────────────────────────────
# Live venues the ingestion daemon connects to (public endpoints; no keys).
# The legacy synthetic DEMO venue is refused unconditionally.
INGEST_EXCHANGE=DERIBIT
# Execution: MARKET_BROKER arms the execution stage.
#   paper|simulated — deterministic execution against real marks.
#   real            — LIVE Deribit order routing (private API). FAIL-CLOSED
#                     prerequisites, or execution stays unarmed (signals flow):
#                     MARKET_DATA_SOURCE=realtime +
#                     MARKET_JOURNAL_PATH set + Deribit credentials below.
MARKET_BROKER=paper
MARKET_DATA_SOURCE=realtime
# Durability journals (restart continuity; recovery failures halt execution).
MARKET_JOURNAL_PATH=./data/market-journal.ndjson
RISK_JOURNAL_PATH=./data/risk-journal.ndjson
# Pre-trade gates: Phase 8 risk engine + Phase 9.7 control plane.
RISK_ENGINE=on
CONTROL_PLANE=on

# ── Real venue order routing (Deribit private API) ────────────────────────
# API key (client credentials) with `trade` scope. DERIBIT_ENV defaults to the
# TEST venue (test.deribit.com); routing real capital requires the explicit
# value `live`. Orders route to LINEAR USDC perpetuals (venue amount = base
# coin, matching Order.qty); override the canonical→instrument map with
# DERIBIT_INSTRUMENT_MAP (JSON object).
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
DERIBIT_ENV=test
# DERIBIT_INSTRUMENT_MAP={"BTC-PERP":"BTC_USDC-PERPETUAL","ETH-PERP":"ETH_USDC-PERPETUAL"}

# ── Persistent portfolio & equity ledger ──────────────────────────────────
# PORTFOLIO_LEDGER=on persists a PortfolioSnapshot (equity/exposure/drawdown/
# open positions) every worker tick — the durable equity series the dashboard
# and risk review read; recovered peak equity keeps drawdown continuous across
# restarts. Identity defaults: name "production", base currency USDT.
PORTFOLIO_LEDGER=on
PORTFOLIO_NAME=production
PORTFOLIO_BASE_CURRENCY=USDT

# ── Production compose (docker/docker-compose.prod.yml) ───────────────────
# Required by the production stack (fail-closed at compose start):
# POSTGRES_PASSWORD — production DB password (compose builds DATABASE_URL)
# OPS_CONTROL_TOKEN — see above (also required by the prod compose web service)
POSTGRES_PASSWORD=

# ── Ingestion (Phase 1) ───────────────────────────────────────────────────
# Exchange priority is fixed in code (DERIBIT > BINANCE > BYBIT); these
# control scope only.
INGEST_SYMBOLS=BTC-USDT,ETH-USDT,BTC-PERP,ETH-PERP
INGEST_OPTION_UNDERLYINGS=BTC,ETH
INGEST_TIMEFRAMES=H1,H4,D1
INGEST_BACKFILL_DAYS=730
