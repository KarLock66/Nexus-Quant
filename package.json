{
  "name": "nexus-quant",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Quant Research, Signal Intelligence & Risk Governance Platform",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @nexus/db generate",
    "db:migrate": "pnpm --filter @nexus/db migrate:dev",
    "db:seed": "pnpm --filter @nexus/db seed",
    "ci:infra": "docker compose -f docker/docker-compose.ci.yml up -d",
    "ci:infra:down": "docker compose -f docker/docker-compose.ci.yml down -v",
    "ci:harness": "pnpm --filter @nexus/workers ci:harness",
    "start:prod": "tsx scripts/start.prod.ts"
  },
  "devDependencies": {
    "@nexus/db": "workspace:*",
    "tsx": "^4.19.4",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}
